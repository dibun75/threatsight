# ThreatSight 2 — local development secrets and configuration.
# Copy to .env and keep .env out of version control.
# Never put production credentials in this file.
#
# Preferred host ports below. `make up` selects a free host port when a
# preferred port is occupied and writes the actual values to `.runtime-ports`.

COMPOSE_PROJECT_NAME=threatsight

POSTGRES_USER=threatsight
POSTGRES_PASSWORD=changeme-dev-only
POSTGRES_DB=threatsight
POSTGRES_PORT=5432

THREATSIGHT_ENV=development
THREATSIGHT_LOG_LEVEL=INFO
THREATSIGHT_LOG_JSON=true
THREATSIGHT_DATABASE_URL=postgresql+psycopg://threatsight:changeme-dev-only@postgres:5432/threatsight
THREATSIGHT_CORS_ORIGINS=http://localhost:3000
THREATSIGHT_SANDBOX_DEFAULT=true
THREATSIGHT_KILL_SWITCH=false
THREATSIGHT_RUN_MIGRATIONS=true
THREATSIGHT_EXTRACTION_PROVIDER=heuristic
THREATSIGHT_INTELLIGENCE_PROVIDER=heuristic
THREATSIGHT_OPENAI_API_KEY=
THREATSIGHT_OPENAI_MODEL=gpt-4o-mini
THREATSIGHT_OPENAI_BASE_URL=https://api.openai.com/v1
THREATSIGHT_MAX_DOCUMENT_BYTES=10485760
THREATSIGHT_ASSURANCE_ADAPTER=http
THREATSIGHT_DEMO_AGENT_URL=http://demo-agent:8090
THREATSIGHT_DISCOVERY_ADAPTER=http
THREATSIGHT_DEMO_SITE_URL=http://demo-site:8091
THREATSIGHT_API_TOKEN=
THREATSIGHT_OPENAPI_ENABLED=true
THREATSIGHT_EVIDENCE_FRESH_DAYS=30

# AI agents and model comparison (world service): a local OpenAI-compatible model (e.g. Ollama).
# Leave the model empty to use the scripted baseline only. These are defaults: an administrator can
# override them, pick the agent and fix-proposer models, and add OpenRouter or other endpoints on /settings.
# The OpenAI settings above, the evidence window, upload limit and kill switch can be overridden there too.
THREATSIGHT_LLM_BASE_URL=http://host.docker.internal:11434/v1
THREATSIGHT_LLM_MODEL=

API_PORT=8000
WEB_PORT=3000
API_INTERNAL_URL=http://api:8000
