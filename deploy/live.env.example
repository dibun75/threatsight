# Copy to .deploy.env in the repo root on the live host (it is gitignored) and fill in the paths.
# `make deploy` loads .env, .runtime-ports and then this file, and refuses to start if a secret path
# below is unset or missing. Keep secrets themselves in the referenced files, not here.

# Also copy here any other variables the live stack was started with (auth mode, OIDC, public URL...)
# that are not already in .env.

# Overlays to load on top of docker-compose.yml. Default: all six below.
# THREATSIGHT_DEPLOY_OVERLAYS=tunnel signing threatfox abusech vulncheck telemetry

# docker-compose.signing.yml. The signer is never rebuilt by deploy; set its pinned merge-SHA tag here.
THREATSIGHT_EVIDENCE_SIGNING_KEY_PATH=/var/lib/threatsight/evidence-signing/ed25519-private.pem
THREATSIGHT_SIGNER_IMAGE_TAG=
THREATSIGHT_DEPLOYMENT_ID=
THREATSIGHT_EVIDENCE_SIGNING_KEY_ID=

# docker-compose.threatfox.yml and docker-compose.abusech.yml (the same abuse.ch key works for both)
THREATSIGHT_THREATFOX_USAGE_MODE=personal_evaluation
THREATSIGHT_THREATFOX_AUTH_KEY_PATH=/var/lib/threatsight/threatfox/auth_key
THREATSIGHT_ABUSECH_AUTH_KEY_PATH=/var/lib/threatsight/threatfox/auth_key

# docker-compose.vulncheck.yml
THREATSIGHT_VULNCHECK_TOKEN_PATH=/var/lib/threatsight/vulncheck/token

# docker-compose.telemetry.yml
THREATSIGHT_RADAR_TOKEN_PATH=

# Leave unset: deploy tags images with the current commit. Set it to an older tag to roll back
# with `make deploy ARGS=--skip-build`.
# THREATSIGHT_IMAGE_TAG=
