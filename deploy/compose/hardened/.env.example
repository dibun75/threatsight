# Safe example for hardened pilot Compose. Copy to .env and fill non-secret values.
# Secrets live under ./secrets/ (never commit).

THREATSIGHT_PUBLIC_ORIGIN=https://threatsight.example
THREATSIGHT_CORS_ORIGINS=https://threatsight.example
THREATSIGHT_WEB_ORIGINS=https://threatsight.example
THREATSIGHT_AUTH_MODE=oidc
THREATSIGHT_OIDC_ISSUER=https://login.example/realms/threatsight
THREATSIGHT_OIDC_AUDIENCE=threatsight-api
THREATSIGHT_OIDC_CLIENT_ID=threatsight
THREATSIGHT_OIDC_AUTHORIZATION_ENDPOINT=https://login.example/realms/threatsight/protocol/openid-connect/auth
THREATSIGHT_OIDC_TOKEN_ENDPOINT=https://login.example/realms/threatsight/protocol/openid-connect/token
THREATSIGHT_OIDC_JWKS_URI=https://login.example/realms/threatsight/protocol/openid-connect/certs
THREATSIGHT_OIDC_REDIRECT_URI=https://threatsight.example/api/v1/auth/callback
THREATSIGHT_SANDBOX_DEFAULT=true
THREATSIGHT_LOG_JSON=true
THREATSIGHT_LOG_LEVEL=INFO
THREATSIGHT_API_HOST_PORT=18080
THREATSIGHT_WEB_HOST_PORT=13000
